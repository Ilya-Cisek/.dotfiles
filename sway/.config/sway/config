### Variables ###############################################################

set $scripts $HOME/.config/sway/scripts

set $mod Mod4

set $term kitty
set $tmux kitty tmux new-session -A -s main
set $browser zen-browser
set $filemanager thunar
set $messenger Telegram
set $menu sh -c 'killall fuzzel || fuzzel --show drun'

# set $wallpaper $HOME/Pictures/wallpaper/abstact-purple.png 
set $wallpaper $HOME/Pictures/wallpaper/abstact-purple.png

### Input ###################################################################

input type:keyboard {
    xkb_layout us,ru
    xkb_options ctrl:nocaps,grp:alt_space_toggle
}

input type:touchpad {
    natural_scroll enabled
    tap enabled
    click_method clickfinger
}

### Startup #################################################################

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK DISPLAY
exec systemctl --user restart xdg-desktop-portal.service xdg-desktop-portal-gtk.service
exec lxqt-policykit-agent
exec_always "killall swaybg; swaybg -i $wallpaper -m fill"

exec_always "killall waybar; waybar &"
exec mako
exec swayosd-server
exec clash-verge
exec_always "killall kanshi; kanshi &"
exec_always "killall swayidle; swayidle -w &"
exec gsettings set org.gnome.desktop.interface color-scheme prefer-dark
### Applications ############################################################

bindsym --to-code $mod+n exec $term
bindsym --to-code $mod+Return exec $tmux

bindsym --to-code $mod+b exec $browser
bindsym --to-code $mod+f exec $filemanager
bindsym --to-code $mod+t exec $messenger
bindsym --to-code $mod+space exec $menu

### Windows #################################################################

default_border pixel 2
default_floating_border pixel 2

# class                 border  backgr. text    indicator child_border
client.focused          #5c3a8a #5c3a8a #ffffff #5c3a8a   #5c3a8a

blur enable
blur_passes 3
blur_radius 4

bindsym --to-code $mod+x kill
bindsym --to-code $mod+Shift+x exec $scripts/force-kill
bindsym --to-code $mod+v floating toggle
bindsym --to-code $mod+F11 fullscreen toggle
bindsym --to-code $mod+Shift+i exec $scripts/idle-toggle

### Focus ###################################################################

bindsym --to-code $mod+h focus left
bindsym --to-code $mod+j focus down
bindsym --to-code $mod+k focus up
bindsym --to-code $mod+l focus right

### Move windows ############################################################

bindsym --to-code $mod+Ctrl+h move left
bindsym --to-code $mod+Ctrl+j move down
bindsym --to-code $mod+Ctrl+k move up
bindsym --to-code $mod+Ctrl+l move right

### Resize ##################################################################

mode "resize" {
    bindsym --to-code h resize shrink width 100 px
    bindsym --to-code l resize grow width 100 px
    bindsym --to-code k resize shrink height 100 px
    bindsym --to-code j resize grow height 100 px

    bindsym --to-code Shift+h move left
    bindsym --to-code Shift+j move down
    bindsym --to-code Shift+k move up
    bindsym --to-code Shift+l move right

    bindsym --to-code Return mode "default"
    bindsym --to-code Escape mode "default"
}

bindsym --to-code $mod+Shift+r mode "resize"

bindsym --to-code $mod+minus resize shrink width 100 px
bindsym --to-code $mod+equal resize grow width 100 px

bindsym --to-code $mod+bracketleft move left
bindsym --to-code $mod+bracketright move right

### Workspaces ##############################################################

set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

bindsym --to-code Ctrl+Alt+l exec $scripts/ws-next
bindsym --to-code Ctrl+Alt+h exec $scripts/ws-prev

bindgesture swipe:3:right exec $scripts/ws-prev
bindgesture swipe:3:left exec $scripts/ws-next
bindsym --to-code Ctrl+Alt+Shift+l exec $scripts/ws-move-next
bindsym --to-code Ctrl+Alt+Shift+h exec $scripts/ws-move-prev

bindsym --to-code $mod+1 workspace number $ws1
bindsym --to-code $mod+2 workspace number $ws2
bindsym --to-code $mod+3 workspace number $ws3
bindsym --to-code $mod+4 workspace number $ws4
bindsym --to-code $mod+5 workspace number $ws5
bindsym --to-code $mod+6 workspace number $ws6
bindsym --to-code $mod+7 workspace number $ws7
bindsym --to-code $mod+8 workspace number $ws8
bindsym --to-code $mod+9 workspace number $ws9
bindsym --to-code $mod+0 workspace number $ws10

bindsym --to-code $mod+Shift+1 move container to workspace number $ws1
bindsym --to-code $mod+Shift+2 move container to workspace number $ws2
bindsym --to-code $mod+Shift+3 move container to workspace number $ws3
bindsym --to-code $mod+Shift+4 move container to workspace number $ws4
bindsym --to-code $mod+Shift+5 move container to workspace number $ws5
bindsym --to-code $mod+Shift+6 move container to workspace number $ws6
bindsym --to-code $mod+Shift+7 move container to workspace number $ws7
bindsym --to-code $mod+Shift+8 move container to workspace number $ws8
bindsym --to-code $mod+Shift+9 move container to workspace number $ws9
bindsym --to-code $mod+Shift+0 move container to workspace number $ws10

### Reload / Exit ###########################################################

bindsym --to-code $mod+Shift+c reload
bindsym --to-code $mod+Shift+e exit
bindsym --to-code $mod+Shift+w exec "killall waybar; waybar"

### Screenshots ##############################################################

bindsym --to-code $mod+s exec $scripts/screenshot
bindsym --to-code $mod+Shift+s exec $scripts/screenshot-region

### Lid ######################################################################

bindswitch --reload lid:on exec $scripts/lid-handler close
bindswitch --reload lid:off exec $scripts/lid-handler open

### Mouse ###################################################################

floating_modifier $mod normal

### Multimedia ##############################################################

bindsym --to-code XF86AudioRaiseVolume exec swayosd-client --output-volume raise
bindsym --to-code XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym --to-code XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym --to-code XF86AudioMicMute exec swayosd-client --input-volume mute-toggle

bindsym --to-code XF86MonBrightnessUp exec swayosd-client --brightness raise
bindsym --to-code XF86MonBrightnessDown exec swayosd-client --brightness lower

bindsym --to-code XF86AudioNext exec playerctl next
bindsym --to-code XF86AudioPrev exec playerctl previous
bindsym --to-code XF86AudioPlay exec playerctl play-pause
bindsym --to-code XF86AudioPause exec playerctl play-pause

### Window rules ############################################################

for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="org.gnome.Calendar"] floating enable
