#!/usr/bin/env bash

ac_online() {
    [ "$(cat /sys/class/power_supply/ACAD/online 2>/dev/null)" = "1" ]
}

start_swayidle() {
    pkill -x swayidle
    if ac_online; then
        dpms_timeout=300
    else
        dpms_timeout=120
    fi
    swayidle -w \
        timeout 600 'swaylock -f' \
        timeout "$dpms_timeout" 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' \
        before-sleep 'swaylock -f' &
}

cleanup() {
    pkill -x swayidle
    [ -n "$upower_pid" ] && kill "$upower_pid" 2>/dev/null
}
trap cleanup EXIT INT TERM

start_swayidle

coproc UPOWER_FD { upower --monitor; }
upower_pid=$!

while read -r _ <&"${UPOWER_FD[0]}"; do
    start_swayidle
done
