### Variables ###############################################################

set $scripts $HOME/.config/sway/scripts

set $mod Mod4

set $term kitty
set $tmux kitty tmux new-session -A -s main
set $browser zen-browser
set $filemanager thunar
set $messenger Telegram
set $menu sh -c 'killall fuzzel || fuzzel --show drun'

set $wallpaper $HOME/Pictures/wallpaper/abstact-purple.png 

### Input ###################################################################

input type:keyboard {
    xkb_layout us,ru
    xkb_options ctrl:nocaps,grp:alt_space_toggle
}

input type:touchpad {
    natural_scroll enabled
    tap enabled
    click_method clickfinger
}

### Startup #################################################################

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK DISPLAY
exec systemctl --user restart xdg-desktop-portal.service xdg-desktop-portal-gtk.service

exec_always "killall swaybg; swaybg -i $wallpaper -m fill"

exec waybar
exec mako
exec swayosd-server
exec clash-verge
exec kanshi
exec $scripts/idle-wrapper
exec gsettings set org.gnome.desktop.interface color-scheme prefer-dark
### Applications ############################################################

bindsym $mod+n exec $term
bindsym $mod+Return exec $tmux

bindsym $mod+b exec $browser
bindsym $mod+f exec $filemanager
bindsym $mod+t exec $messenger
bindsym $mod+space exec $menu

### Windows #################################################################

default_border pixel 2
default_floating_border pixel 2

# class                 border  backgr. text    indicator child_border
client.focused          #5c3a8a #5c3a8a #ffffff #5c3a8a   #5c3a8a

blur enable
blur_passes 3
blur_radius 4

bindsym $mod+x kill
bindsym $mod+Shift+x exec $scripts/force-kill
bindsym $mod+v floating toggle
bindsym $mod+F11 fullscreen toggle
bindsym $mod+Shift+i exec $scripts/idle-toggle

### Focus ###################################################################

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

### Move windows ############################################################

bindsym $mod+Ctrl+h move left
bindsym $mod+Ctrl+j move down
bindsym $mod+Ctrl+k move up
bindsym $mod+Ctrl+l move right

### Resize ##################################################################

mode "resize" {
    bindsym h resize shrink width 100 px
    bindsym l resize grow width 100 px
    bindsym k resize shrink height 100 px
    bindsym j resize grow height 100 px

    bindsym Shift+h move left
    bindsym Shift+j move down
    bindsym Shift+k move up
    bindsym Shift+l move right

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+Shift+r mode "resize"

bindsym $mod+minus resize shrink width 100 px
bindsym $mod+equal resize grow width 100 px

bindsym $mod+bracketleft move left
bindsym $mod+bracketright move right

### Workspaces ##############################################################

set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

bindsym Ctrl+Alt+l exec $scripts/ws-next
bindsym Ctrl+Alt+h exec $scripts/ws-prev

bindgesture swipe:3:right exec $scripts/ws-prev
bindgesture swipe:3:left exec $scripts/ws-next
bindsym Ctrl+Alt+Shift+l exec $scripts/ws-move-next
bindsym Ctrl+Alt+Shift+h exec $scripts/ws-move-prev

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

### Reload / Exit ###########################################################

bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit
bindsym $mod+Shift+w exec "killall waybar; waybar"

### Screenshots ##############################################################

bindsym $mod+s exec $scripts/screenshot
bindsym $mod+Shift+s exec $scripts/screenshot-region

### Lid ######################################################################

bindswitch --reload lid:on exec $scripts/lid-handler close
bindswitch --reload lid:off exec $scripts/lid-handler open

### Mouse ###################################################################

floating_modifier $mod normal

### Multimedia ##############################################################

bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume raise
bindsym XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym XF86AudioMicMute exec swayosd-client --input-volume mute-toggle

bindsym XF86MonBrightnessUp exec swayosd-client --brightness raise
bindsym XF86MonBrightnessDown exec swayosd-client --brightness lower

bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause

### Window rules ############################################################

for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="org.gnome.Calendar"] floating enable
